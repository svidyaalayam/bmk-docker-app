# Copy to the ignored .env.production and replace secret/database values before use.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=false
APP_DOMAIN=balamukundam.com
VITE_APP_DOMAIN=balamukundam.com
TENANT_HOST_SUFFIX=
VITE_TENANT_HOST_SUFFIX=
PLATFORM_HOSTNAME=balamukundam.com
VITE_PLATFORM_HOSTNAME=balamukundam.com
VITE_APP_ENV=production
DJANGO_ALLOWED_HOSTS=balamukundam.com,.balamukundam.com,api,web
CSRF_TRUSTED_ORIGINS=https://balamukundam.com,https://*.balamukundam.com
CORS_ALLOW_ALL_ORIGINS=false
CORS_ALLOWED_ORIGINS=
CORS_ALLOWED_ORIGIN_REGEXES=^https://[a-z0-9-]+\.balamukundam\.com$
FRONTEND_BASE_URL=https://balamukundam.com
WEB_PORT=8082
API_PORT=8002
# VM Nginx is the only public entry point.
WEB_BIND_HOST=127.0.0.1
API_BIND_HOST=127.0.0.1
