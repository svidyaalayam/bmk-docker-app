# Copy to the ignored .env.staging and replace secret/database values before use.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=false
APP_DOMAIN=staging.balamukundam.com
VITE_APP_DOMAIN=staging.balamukundam.com
VITE_APP_ENV=staging
DJANGO_ALLOWED_HOSTS=staging.balamukundam.com,.staging.balamukundam.com,api,web
CSRF_TRUSTED_ORIGINS=https://staging.balamukundam.com,https://*.staging.balamukundam.com
CORS_ALLOW_ALL_ORIGINS=false
CORS_ALLOWED_ORIGINS=
CORS_ALLOWED_ORIGIN_REGEXES=^https://[a-z0-9-]+\.staging\.balamukundam\.com$
FRONTEND_BASE_URL=https://staging.balamukundam.com
WEB_PORT=8080
API_PORT=8000
