# Copy to the ignored .env.staging and replace secret/database values before use.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=false
APP_DOMAIN=balamukundam.com
VITE_APP_DOMAIN=balamukundam.com
SCHOOL_SLUG=uk-telugu
SCHOOL_NAME=UK Telugu
VITE_APP_ENV=staging
DJANGO_ALLOWED_HOSTS=staging.balamukundam.com,api,web
CSRF_TRUSTED_ORIGINS=https://staging.balamukundam.com
CORS_ALLOW_ALL_ORIGINS=false
CORS_ALLOWED_ORIGINS=https://staging.balamukundam.com
CORS_ALLOWED_ORIGIN_REGEXES=
FRONTEND_BASE_URL=https://staging.balamukundam.com
WEB_PORT=8081
API_PORT=8001
# VM Nginx is the only public entry point.
WEB_BIND_HOST=127.0.0.1
API_BIND_HOST=127.0.0.1
