# Copy to `.env` and adjust as needed.
# docker compose --env-file .env up --build

# --- Postgres ---
POSTGRES_DB=bmk
POSTGRES_USER=bmk
POSTGRES_PASSWORD=bmkchangeme

# --- Django ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=false
# Comma-separated hosts Django will accept. Add your VM public IP / nip.io base, e.g.:
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.localhost,api,web,20.1.2.3,20.1.2.3.nip.io,.20.1.2.3.nip.io
# For a quick demo on any host/IP you can use: *
# host.docker.internal lets Sikshavahini (sibling Docker) call this API
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.localhost,api,web,host.docker.internal
# Include every origin you use in the browser (scheme + host [+ port]).
CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:8080,http://127.0.0.1:8080,http://uk-telugu.localhost:8080,http://balavikas.localhost:8080
CORS_ALLOW_ALL_ORIGINS=false
CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:8080,http://127.0.0.1:8080
CORS_ALLOWED_ORIGIN_REGEXES=^http://([a-z0-9-]+\.)?localhost(:\d+)?$
SEED_ON_START=true
GUNICORN_WORKERS=3

# --- Frontend build ---
# Base domain for school subdomains: {slug}{TENANT_HOST_SUFFIX}.{APP_DOMAIN}.
# Keep each API setting aligned with its VITE_ counterpart.
# Local: localhost
# VM test with nip.io: 20.1.2.3.nip.io  (replace with your public IP)
APP_DOMAIN=localhost
VITE_APP_DOMAIN=localhost
TENANT_HOST_SUFFIX=
VITE_TENANT_HOST_SUFFIX=
PLATFORM_HOSTNAME=localhost
VITE_PLATFORM_HOSTNAME=localhost
VITE_API_BASE_URL=
# Shown on platform home: local | test | staging | production
VITE_APP_ENV=local
# Sikshavahini web URL for dashboard “Open Sikshavahini” button
VITE_SIKSHAVAHINI_URL=http://localhost:8180
# Sunaadam web URL for schools whose lesson app is Sunaadam
VITE_SUNAADAM_URL=http://localhost:8280

# Published ports on the host (must be unique if prod+test run on the same VM)
WEB_PORT=8080
API_PORT=8000

# Email (console = print to API logs; Resend SMTP configuration for live email)
# Do not commit the real API key. Copy these values to the ignored `.env` file or
# your deployment secret store, then replace the password placeholder.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=Balamukundam Vidyalayam <noreply@balamukundam.com>
FRONTEND_BASE_URL=https://balamukundam.com
# To enable Resend, change EMAIL_BACKEND to the SMTP backend and uncomment below.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.resend.com
EMAIL_PORT=587
EMAIL_HOST_USER=resend
EMAIL_HOST_PASSWORD=xxxxx
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false

# --- File storage ---
# Avatars + school logos always use local Docker volume (MEDIA_ROOT).
# Student homework + teacher session materials:
#   local       = Docker volume (default for local/dev)
#   azure_blob  = Azure Blob Storage (requires credentials below)
HOMEWORK_STORAGE_BACKEND=local
# AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net
# Or instead of connection string:
# AZURE_STORAGE_ACCOUNT_NAME=
# AZURE_STORAGE_ACCOUNT_KEY=
AZURE_STORAGE_CONTAINER=bmk-homework
SIKSHAVAHINI_SHARED_SECRET=siksha-dev-shared-secret
SUNAADAM_SHARED_SECRET=sunaadam-dev-shared-secret
