# Copy to `.env` and adjust as needed.
# docker compose --env-file .env up --build

# --- Postgres ---
POSTGRES_DB=bmk
POSTGRES_USER=bmk
POSTGRES_PASSWORD=bmkchangeme

# --- Django ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.localhost,api,web
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://balamukundam.localhost:8080,http://balavikas.localhost:8080
CORS_ALLOW_ALL_ORIGINS=false
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
CORS_ALLOWED_ORIGIN_REGEXES=^http://([a-z0-9-]+\.)?localhost:8080$
SEED_ON_START=true
GUNICORN_WORKERS=3

# --- Frontend build ---
VITE_APP_DOMAIN=localhost
VITE_API_BASE_URL=

# Published web port on the host
WEB_PORT=8080
