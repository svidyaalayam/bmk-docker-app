# Install on the VM as /etc/nginx/sites-available/bmk-test.conf.
# The Docker web service must be published on 127.0.0.1:8080 (or update the
# upstream below). The certificate and key are Cloudflare Origin CA files.

server {
    listen 80;
    listen [::]:80;
    server_name test.balamukundam.com ~^[a-z0-9-]+-test\.balamukundam\.com$;

    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name test.balamukundam.com ~^[a-z0-9-]+-test\.balamukundam\.com$;

    ssl_certificate     /etc/ssl/cloudflare/balamukundam-origin.pem;
    ssl_certificate_key /etc/ssl/cloudflare/balamukundam-origin.key;
    ssl_protocols       TLSv1.2 TLSv1.3;

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }
}
