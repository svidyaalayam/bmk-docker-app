# Copy to `.env` and adjust as needed.
# docker compose --env-file .env up --build

# --- Postgres ---
POSTGRES_DB=bmk
POSTGRES_USER=bmk
POSTGRES_PASSWORD=bmkchangeme

# --- Django ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=false
# Comma-separated hosts Django will accept. Add your VM public IP, e.g.:
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.localhost,api,web,20.1.2.3
# For a quick demo on any host/IP you can use: *
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.localhost,api,web
# Include every origin you use in the browser (scheme + host [+ port])
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:8080,http://127.0.0.1:8080,http://uk.telugu.localhost:8080,http://balavikas.localhost:8080
CORS_ALLOW_ALL_ORIGINS=false
CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:8080,http://127.0.0.1:8080
CORS_ALLOWED_ORIGIN_REGEXES=^http://([a-z0-9-]+\.)?localhost(:\d+)?$
SEED_ON_START=true
GUNICORN_WORKERS=3

# --- Frontend build ---
VITE_APP_DOMAIN=localhost
VITE_API_BASE_URL=

# Published web port on the host (8080 locally; use 80 on a VM if you prefer http://localhost/admin/)
WEB_PORT=8080

# --- File storage ---
# Avatars + school logos always use local Docker volume.
# Student homework + teacher session materials: local | azure_blob
HOMEWORK_STORAGE_BACKEND=local
# AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net
# AZURE_STORAGE_ACCOUNT_NAME=
# AZURE_STORAGE_ACCOUNT_KEY=
AZURE_STORAGE_CONTAINER=bmk-homework
AZURE_BLOB_SAS_EXPIRY_HOURS=24
